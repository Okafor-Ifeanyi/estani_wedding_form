# ---- Database -------------------------------------------------------------
# Hosted PostgreSQL. Both URLs point at the same database:
#   DATABASE_URL         - the POOLED endpoint the running app queries through.
#   DIRECT_DATABASE_URL  - the DIRECT (unpooled) endpoint Prisma Migrate needs.
# If your provider does not offer a pooler, set both to the same value.
#
# Prisma Postgres, for example:
#   DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
#   DIRECT_DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
#
# Neon / Supabase / RDS and friends work the same way — swap in their hosts.
# Keep `sslmode=require` (or stronger) for any database reached over the network.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional: a scratch database Prisma may create/drop while running
# `prisma migrate dev`. Most hosted providers forbid CREATE DATABASE, so leave
# this unset and use the `db:migrate:new` + `db:deploy` flow instead (see README).
# SHADOW_DATABASE_URL=""

# ---- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (the client dev server).
CORS_ORIGIN="http://localhost:5173"

# ---- Auth -----------------------------------------------------------------
# Generate a strong value for production, e.g. `openssl rand -hex 32`.
JWT_SECRET="change-me-in-production-please"
JWT_EXPIRES_IN="7d"

# ---- Seed admin (created by `npm run seed`) -------------------------------
SEED_ADMIN_EMAIL="admin@yourstudio.com"
SEED_ADMIN_PASSWORD="changeme123"
SEED_ADMIN_NAME="Studio Admin"

# ---- Uploads --------------------------------------------------------------
# Max size per uploaded file, in megabytes.
MAX_UPLOAD_MB=25
UPLOAD_DIR="uploads"
