{
  "name": "wedding-intake",
  "version": "1.0.0",
  "private": true,
  "description": "Wedding invitation intake form (React + TypeScript) with a database-backed API and admin dashboard for follow-up.",
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "setup:server": "npm --prefix server run setup",
    "typecheck": "npm-run-all typecheck:server typecheck:client",
    "typecheck:server": "npm --prefix server run typecheck",
    "typecheck:client": "npm --prefix client run typecheck",
    "build": "npm-run-all build:server build:client",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "db:status": "npm --prefix server run prisma:status",
    "db:deploy": "npm --prefix server run prisma:deploy",
    "db:migrate:new": "npm --prefix server run prisma:migrate:new",
    "db:studio": "npm --prefix server run prisma:studio"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
